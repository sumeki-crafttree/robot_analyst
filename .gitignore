# macOS
.DS_Store

# Office 一時ファイル（開いたままのロックファイル）
~$*

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 環境変数・認証情報
.env
.env.*
*.key
*.pem

# パイプラインのデータ層（原本・中間生成物）
# data/master と data/product は追跡対象のため除外しない
data/original/
data/raw/
data/processed/
data/report/

# 旧設計の退避先（履歴はローカルのみ保持）
docs/02_schema/archive/
